<div metal:use-macro="load: ../shared/_layout.pt"
     xmlns:tal="http://xml.zope.org/namespaces/tal"
     xmlns:metal="http://xml.zope.org/namespaces/metal">
    <main metal:fill-slot="content" class="container mt-4">
        <!-- Dashboard Header & Auto-Refresh Controls -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 text-white">
            <div>
                <h2 class="mb-0 fw-bold">Cabin Heaters</h2>
                <small class="text-white-50">
                    <i class="bi bi-clock-history me-1"></i>Last updated: 
                    <span id="last-updated-val" tal:content="last_updated | 'Just now'">--:--:--</span>
                </small>
            </div>
            <div tal:condition="python: int(refresh_interval or 0) != 0" class="d-flex flex-wrap align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: auto;">
                    <span class="input-group-text bg-dark text-white border-secondary">
                        <i class="bi bi-arrow-repeat me-1"></i>Auto-refresh:
                    </span>
                    <select id="auto-refresh-select" class="form-select form-select-sm bg-dark text-white border-secondary"
                            tal:attributes="data-interval refresh_interval"
                            aria-label="Auto-refresh interval">
                        <option value="0">Off</option>
                        <option value="30">30 sec</option>
                        <option value="60">1 min</option>
                        <option value="120" selected="selected">2 min (default)</option>
                        <option value="300">5 min</option>
                        <option value="600">10 min</option>
                    </select>
                </div>
                <span id="refresh-countdown-badge" class="badge bg-secondary text-white py-2 px-3 d-flex align-items-center" title="Time until next auto-refresh">
                    <i class="bi bi-hourglass-split me-1"></i>
                    <span>Next update: <strong id="countdown-display">02:00</strong></span>
                </span>
                <a href="/heaters/" id="btn-manual-refresh" class="btn btn-sm btn-primary d-flex align-items-center" title="Refresh now">
                    <i class="bi bi-arrow-clockwise me-1" id="refresh-icon"></i>
                    <span>Refresh</span>
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4" tal:repeat="room rooms">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0" tal:content="room.name">Room Name</h5>
                        <div class="d-flex align-items-center gap-1">
                            <span tal:condition="room.has_unavailable_heaters" class="badge bg-warning text-dark" title="One or more heaters are offline">
                                <i class="bi bi-exclamation-triangle me-1"></i>Offline
                            </span>
                            <span class="badge bg-info text-dark">Heaters: <span tal:replace="python: len(room.heaters)">0</span></span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <div class="text-muted small">Average</div>
                                <div class="fs-5 text-primary"><span tal:replace="python: '{:.1f}'.format(room.average_temp)">&deg;C</span>&nbsp;&deg;C</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Setpoint</div>
                                <div class="fs-5"><span tal:replace="python: '{:.1f}'.format(room.current_setpoint)">&deg;C</span>&nbsp;&deg;C</div>
                            </div>
                        </div>

                        <form tal:attributes="action python: '/heaters/set_temp/{}'.format(room.id)" method="post" class="mb-3">
                            <div class="input-group">
                                <input type="number" name="setpoint" step="0.5" class="form-control" min="5" max="30"
                                       tal:attributes="value python: '{:.1f}'.format(room.current_setpoint)" aria-label="Setpoint">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-thermometer-half me-1"></i>Set
                                </button>
                            </div>
                        </form>

                        <h6 class="text-muted">Heaters</h6>
                        <ul class="list-group list-group-flush">
                            <li tal:repeat="heater room.heaters"
                                tal:attributes="class python: 'list-group-item d-flex justify-content-between align-items-center bg-light text-muted opacity-75' if not heater.is_available else 'list-group-item d-flex justify-content-between align-items-center'">
                                <div>
                                    <span tal:attributes="class python: 'fw-semibold text-muted' if not heater.is_available else 'fw-semibold'">
                                        <i tal:condition="not heater.is_available" class="bi bi-exclamation-circle text-danger me-1"></i>
                                        <span tal:replace="heater.name">Heater Name</span>
                                    </span>
                                    <span tal:condition="heater.is_available" class="ms-1">
                                        <span tal:replace="python: '{:.1f}'.format(heater.current_temp) if heater.current_temp is not None else '--'">&deg;C</span>&deg;C
                                        / <span tal:replace="python: '{:.1f}'.format(heater.setpoint) if heater.setpoint is not None else '--'">&deg;C</span>&deg;C
                                    </span>
                                    <span tal:condition="not heater.is_available" class="ms-2 badge bg-secondary-subtle text-secondary border">
                                        <i class="bi bi-dash-circle me-1"></i>Unavailable
                                    </span>
                                </div>
                                <div>
                                    <span tal:condition="not heater.is_available" class="badge rounded-pill bg-danger" title="Heater is offline or unreachable">
                                        <i class="bi bi-wifi-off me-1"></i>Offline
                                    </span>
                                    <span tal:condition="heater.is_available and heater.is_on" class="badge rounded-pill bg-success">
                                        <i class="bi bi-power me-1"></i>ON
                                    </span>
                                    <span tal:condition="heater.is_available and not heater.is_on" class="badge rounded-pill bg-secondary">
                                        <i class="bi bi-power me-1"></i>OFF
                                    </span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <script tal:condition="python: int(refresh_interval or 0) != 0">
            //<![CDATA[
            (function() {
                let select = document.getElementById('auto-refresh-select');
                let countdownDisplay = document.getElementById('countdown-display');
                let countdownBadge = document.getElementById('refresh-countdown-badge');
                let refreshBtn = document.getElementById('btn-manual-refresh');
                let refreshIcon = document.getElementById('refresh-icon');

                if (!select || !countdownDisplay) {
                    return;
                }

                let defaultInterval = parseInt(select.getAttribute('data-interval') || '120', 10);
                let savedInterval = localStorage.getItem('heaters_dashboard_refresh_interval');
                let intervalSeconds = savedInterval !== null ? parseInt(savedInterval, 10) : defaultInterval;

                let validIntervals = [0, 30, 60, 120, 300, 600];
                if (validIntervals.indexOf(intervalSeconds) !== -1) {
                    select.value = intervalSeconds.toString();
                } else {
                    select.value = "120";
                    intervalSeconds = 120;
                }

                let remainingSeconds = intervalSeconds;
                let timerId = null;
                let isRefreshing = false;

                function formatTime(secs) {
                    let m = Math.floor(secs / 60);
                    let s = secs % 60;
                    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
                }

                function isUserInteracting() {
                    let active = document.activeElement;
                    if (active && (active.tagName === 'INPUT' || active.tagName === 'SELECT' || active.tagName === 'TEXTAREA')) {
                        if (active !== select) {
                            return true;
                        }
                    }
                    return false;
                }

                function doRefresh() {
                    if (isRefreshing) {
                        return;
                    }
                    if (isUserInteracting()) {
                        remainingSeconds = 10;
                        updateDisplay();
                        return;
                    }
                    isRefreshing = true;
                    if (timerId) {
                        clearInterval(timerId);
                        timerId = null;
                    }
                    if (refreshIcon) {
                        refreshIcon.classList.add('spin-icon');
                    }
                    if (countdownDisplay) {
                        countdownDisplay.textContent = 'Updating...';
                    }
                    if (refreshBtn) {
                        refreshBtn.classList.add('disabled');
                    }
                    window.location.href = '/heaters/';
                }

                function updateDisplay() {
                    if (isRefreshing) {
                        return;
                    }
                    if (intervalSeconds === 0) {
                        countdownDisplay.textContent = 'Off';
                        if (countdownBadge) {
                            countdownBadge.className = 'badge bg-dark text-muted py-2 px-3 d-flex align-items-center border border-secondary';
                        }
                    } else {
                        countdownDisplay.textContent = formatTime(remainingSeconds);
                        if (countdownBadge) {
                            countdownBadge.className = 'badge bg-secondary text-white py-2 px-3 d-flex align-items-center';
                        }
                    }
                }

                function tick() {
                    if (isRefreshing || intervalSeconds <= 0) {
                        return;
                    }
                    remainingSeconds--;
                    if (remainingSeconds <= 0) {
                        doRefresh();
                    } else {
                        updateDisplay();
                    }
                }

                function startTimer() {
                    if (timerId) {
                        clearInterval(timerId);
                        timerId = null;
                    }
                    if (isRefreshing) {
                        return;
                    }
                    remainingSeconds = intervalSeconds;
                    updateDisplay();
                    if (intervalSeconds > 0) {
                        timerId = setInterval(tick, 1000);
                    }
                }

                select.addEventListener('change', function() {
                    intervalSeconds = parseInt(this.value, 10);
                    localStorage.setItem('heaters_dashboard_refresh_interval', intervalSeconds.toString());
                    startTimer();
                });

                if (refreshBtn) {
                    refreshBtn.addEventListener('click', function(e) {
                        if (isRefreshing) {
                            e.preventDefault();
                            return;
                        }
                        isRefreshing = true;
                        if (timerId) {
                            clearInterval(timerId);
                            timerId = null;
                        }
                        if (refreshIcon) {
                            refreshIcon.classList.add('spin-icon');
                        }
                        if (countdownDisplay) {
                            countdownDisplay.textContent = 'Updating...';
                        }
                    });
                }

                startTimer();
            })();
            //]]>
        </script>
    </main>
</div>
